# Api.RAG no Render (src/Api.RAG/Dockerfile) — feature 004. SOMENTE nomes e valores de exemplo.
# Valores <SEGREDO> vão em Environment (ou Environment Group) do serviço, nunca no Git.
# Demo com dados públicos (Guia Prático); nenhum valor abaixo é política ou aprovação de produção.

ConfigurationPurpose=CloudDemo_NotApprovedForProduction

# --- Banco (Neon, banco "rag", papel de aplicação; migração roda fora do serviço, ver T006) ---
# Formato: Host=<EP>.<REGIAO>.aws.neon.tech;Database=rag;Username=rag_application;Password=<...>;SSL Mode=Require
ConnectionStrings__Rag=<SEGREDO>

# --- Identidade (Auth0): API "Api.RAG" ---
Authentication__DisabledForDevelopment=false
Authentication__Authority=https://<TENANT>.us.auth0.com/
Authentication__Audience=https://api-rag.sped.demo
Authentication__Resource=https://<SERVICO-RAG>.onrender.com/mcp
Authentication__RequireHttpsMetadata=true
Authentication__AllowedHosts__0=<SERVICO-RAG>.onrender.com
# Quem pode ingerir: sub do Auth0 (aplicação M2M "<CLIENT_ID>@clients" ou usuário).
Authentication__CentralPermissionAssignments__0__PrincipalId=<SUB_ADMIN>
Authentication__CentralPermissionAssignments__0__Permissions__0=knowledge.ingest
Authentication__CentralPermissionAssignments__0__Permissions__1=knowledge.audit

# --- Borda HTTP: TLS termina no proxy do Render. Rede observada no teste de fumaça (T008). ---
Transport__TrustedNetworks__0=<CIDR_DO_PROXY_RENDER>

# --- Processamento (guia de 433 páginas: ~7 min; o serviço precisa ficar acordado durante a ingestão) ---
Processing__MaxFileBytes=52428800
Processing__MaxPages=1000
Processing__MaxConcurrentJobs=1
Processing__TimeoutSeconds=900
Processing__LeaseSeconds=960
Processing__MaxPreparationAttempts=3
Processing__Profiles__0__Id=d0c0a1e0-0000-4000-8000-000000000005
Processing__Profiles__0__AdoptionState=candidate
Processing__Profiles__0__Segmenter=record-sections
Processing__Profiles__0__ExtractorVersion=pdfpig-0.1.16-reading-order-v1
Processing__Profiles__0__NormalizationVersion=repeated-lines-v1
Processing__Profiles__0__QueryNormalizationVersion=line-endings-v1
Processing__Profiles__0__TokenizerVersion=whitespace-v1
Processing__Profiles__0__ChunkTokens=400
Processing__Profiles__0__OverlapTokens=50
Processing__Profiles__0__EmbeddingProvider=OpenAI
Processing__Profiles__0__EmbeddingModel=text-embedding-3-small
Processing__Profiles__0__Dimensions=1536
Processing__Profiles__0__Metric=cosine
Processing__Profiles__0__TopK=5

Retrieval__MaxQueryCharacters=4000
Retrieval__TimeoutSeconds=10

# --- Embeddings (OpenAI) ---
Embeddings__Provider=OpenAI
Embeddings__Dimensions=1536
Embeddings__TimeoutSeconds=15
Embeddings__MaxAttempts=3
Embeddings__RetryDelayMilliseconds=250
Embeddings__SdkAutomaticRetriesEnabled=false
OpenAI__ApiKey=<SEGREDO>
OpenAI__ChatModel=gpt-4.1-mini
OpenAI__EmbeddingModel=text-embedding-3-small
OpenAI__Pricing__Currency=USD
OpenAI__Pricing__Reference=https://openai.com/api/pricing
OpenAI__Pricing__Embedding__InputPerMillionTokens=0.02

# --- Retenção (demo) ---
Retention__PolicyVersion=demo-cloud-v1
Retention__ApprovalReference=DEMO-PUBLIC-DATA-NOT-APPROVED
Retention__WithdrawnSourceDays=30
Retention__SupersededGenerationDays=30
Retention__OriginalDays=30
Retention__ReferenceDays=30
Retention__TombstoneDays=30
Retention__AuditDays=30
Retention__QueryDays=30
Retention__ConsumptionDays=30
Retention__AutomaticExpurgeEnabled=false
