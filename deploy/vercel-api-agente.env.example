# Api.Agente na Vercel (Dockerfile.vercel) — feature 004. SOMENTE nomes e valores de exemplo.
# Valores marcados <SEGREDO> vão em Project Settings > Environment Variables (Sensitive), nunca no Git.
# Demo com dados sintéticos/públicos; nenhum valor abaixo é política ou aprovação de produção.

# --- Identidade (Auth0): API "Api.Agente" ---
Authentication__DisabledForDevelopment=false
Authentication__Authority=https://<TENANT>.us.auth0.com/
Authentication__Audience=https://api-agente.sped.demo
Authentication__AllowedHosts__0=<PROJETO>.vercel.app
# Sub do Auth0 com acesso ao diagnóstico MCP (opcional), ex.: <CLIENT_ID>@clients
# Authentication__DiagnosticPrincipals__0=

# --- Borda HTTP (feature 003, ADR 0002) ---
# TLS termina no proxy da Vercel. Preencher com a rede do proxy observada no teste de fumaça (T008).
Transport__TrustedNetworks__0=<CIDR_DO_PROXY_VERCEL>
# Sem frontend no navegador: deixar sem origens (CORS desligado).
# Cors__AllowedOrigins__0=https://<FRONTEND_SOFIA>

# --- Limites (corpo de Function da Vercel ~4,5 MB) ---
Limits__MaxRequestBytes=4194304
Limits__TimeoutSeconds=60

# --- Api.RAG via MCP (Render) ---
KnowledgeMcp__Endpoint=https://<SERVICO-RAG>.onrender.com/mcp
KnowledgeMcp__AllowUnauthenticatedLoopback=false
# Token M2M do Auth0 para a API "Api.RAG" com escopo knowledge.read; rotação manual antes de expirar.
KnowledgeMcp__BearerToken=<SEGREDO>
# Render Free pode levar até ~1 min para acordar.
KnowledgeMcp__TimeoutSeconds=60
KnowledgeMcp__MaxResponseBytes=1048576
KnowledgeMcp__MaxQueryCharacters=4000

# --- Gerador do parecer (OpenAI) ---
Llm__Model=gpt-4.1-mini
Llm__ApiKey=<SEGREDO>
Llm__TimeoutSeconds=20
Llm__MaxAttempts=2
Llm__RetryDelayMilliseconds=250
Llm__MaxOutputTokens=2000
Llm__MaxContextCharacters=32000
Llm__MaxOutputCharacters=16000
Llm__Pricing__Currency=USD
Llm__Pricing__Reference=https://openai.com/api/pricing
Llm__Pricing__InputPerMillionTokens=0.4
Llm__Pricing__CachedInputPerMillionTokens=0.1
Llm__Pricing__OutputPerMillionTokens=1.6

# --- Leitor SPED ---
SpedParser__MaxLineBytes=131072
SpedParser__MaxRecords=100000
SpedParser__MaxFieldsPerRecord=512
SpedParser__MaxIssues=100

# --- Auditoria/consumo (Neon, banco "agente", papel de aplicação) ---
# Formato: Host=<EP>.<REGIAO>.aws.neon.tech;Database=agente;Username=agente_application;Password=<...>;SSL Mode=Require
AgentData__ConnectionString=<SEGREDO>
AgentData__PolicyVersion=demo-cloud-v1
AgentData__ApprovalReference=DEMO-SYNTHETIC-NOT-APPROVED
AgentData__AuditDays=7
AgentData__ConsumptionDays=7
AgentData__TimeoutSeconds=10
AgentData__RetentionBatchSize=500

# --- Leiaute provisório (igual ao exemplo Development; decisão fiscal pendente, AG001) ---
LayoutPolicy__Profiles__0__Code=006
LayoutPolicy__Profiles__0__From=2020-01-01
LayoutPolicy__Profiles__0__Through=2026-12-31
LayoutPolicy__Profiles__0__DocumentType=EFD-Contribuicoes
LayoutPolicy__Profiles__0__KnowledgeLayoutVersion=1.35
LayoutPolicy__Profiles__0__SourceReference=Guia Pratico EFD-Contribuicoes 1.35; SHA256:60eace459169238808e3e745e952fcbbbd2af6b7f933b043e8c9692b68f4d08b
LayoutPolicy__Profiles__0__ApprovalReference=DEMO-PROVISIONAL-NOT-APPROVED
