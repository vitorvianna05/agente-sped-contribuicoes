# Copiar para infra/local/.env (ignorado pelo Git) e trocar os valores, ou usar
# scripts/local/setup-rag.ps1, que gera senhas aleatórias e configura os User Secrets.
RAG_DB_PORT=5433
RAG_MIGRATION_PASSWORD=trocar
RAG_APPLICATION_PASSWORD=trocar
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=trocar
