{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentespedcontrib:knowledge:retained-artifacts:1.0",
  "title": "Resposta administrativa de artefatos retidos v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "documentVersionId": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RetainedArtifactMetadata"
      }
    }
  },
  "required": [
    "contractVersion",
    "correlationId",
    "documentVersionId",
    "items"
  ],
  "$defs": {
    "RetainedArtifactMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retainedArtifactId": {
          "type": "string",
          "format": "uuid"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "retained",
            "purged"
          ]
        },
        "eventType": {
          "enum": [
            "withdrawn",
            "superseded"
          ]
        },
        "eventAt": {
          "type": "string",
          "format": "date-time"
        },
        "policyVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "eligibleForExpurgeAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "eligibleForExpurge": {
          "type": "boolean"
        },
        "impediments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revision": {
          "type": "string",
          "pattern": "^\"[A-Za-z0-9._:-]+\"$"
        }
      },
      "required": [
        "retainedArtifactId",
        "category",
        "state",
        "eventType",
        "eventAt",
        "policyVersion",
        "eligibleForExpurgeAt",
        "eligibleForExpurge",
        "impediments",
        "revision"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "policyVersion": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "eligibleForExpurgeAt": {
                "type": "null"
              },
              "eligibleForExpurge": {
                "const": false
              },
              "impediments": {
                "contains": {
                  "const": "RETENTION_NOT_CONFIGURED"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eligibleForExpurge": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "retained"
              },
              "policyVersion": {
                "type": "string",
                "minLength": 1
              },
              "eligibleForExpurgeAt": {
                "type": "string",
                "format": "date-time"
              },
              "impediments": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "purged"
              }
            }
          },
          "then": {
            "properties": {
              "eligibleForExpurge": {
                "const": false
              },
              "impediments": {
                "contains": {
                  "const": "ALREADY_PURGED"
                }
              }
            }
          }
        }
      ]
    }
  }
}
